# Copie para .env.production no servidor e preencha.
# Este arquivo é lido pelo docker-compose.prod.yml — nunca versione o preenchido.

# ---- Domínio e HTTPS ----
APP_DOMAIN="ingressos.seudominio.com.br"
LETSENCRYPT_EMAIL="voce@seudominio.com.br"
NEXT_PUBLIC_APP_URL="https://ingressos.seudominio.com.br"
NEXT_PUBLIC_BRAND_NAME="Ticketeira"

# ---- Banco (fica só na rede interna do Docker) ----
POSTGRES_USER="ticketeira"
POSTGRES_DB="ticketeira"
# Gere com: openssl rand -base64 24
POSTGRES_PASSWORD=""

# ---- Segurança ----
# Gere com: openssl rand -base64 32
AUTH_SECRET=""

# ---- Pagamentos ----
# mock = simulador (deixe assim até validar tudo) | mercadopago = Pix e cartão reais
PAYMENT_PROVIDER="mock"
MP_ACCESS_TOKEN=""
MP_WEBHOOK_SECRET=""
MOCK_PIX_KEY=""

# ---- Regras de negócio ----
DEFAULT_SERVICE_FEE_BPS="1000"
ORDER_EXPIRATION_MINUTES="30"

# ---- Backup ----
BACKUP_RETENTION_DAYS="14"
