# ---- Banco de dados (PostgreSQL) ----
# Local:  docker compose up -d  (usa a string abaixo)
# Nuvem:  Neon, Supabase, Railway, RDS...
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/ticketeira?schema=public"

# ---- Segurança ----
# Gere com: openssl rand -base64 32
AUTH_SECRET="troque-este-segredo-em-producao-minimo-32-caracteres"

# ---- URL pública da aplicação (usada em links e no webhook do gateway) ----
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---- Marca ----
NEXT_PUBLIC_BRAND_NAME="TicketDaun"

# ---- Pagamentos ----
# mock        -> simulador local, funciona sem conta em gateway (padrão para desenvolvimento)
# mercadopago -> Pix + cartão reais via Mercado Pago
PAYMENT_PROVIDER="mock"

# Mercado Pago — https://www.mercadopago.com.br/developers/panel/app
MP_ACCESS_TOKEN=""
MP_WEBHOOK_SECRET=""

# Chave Pix usada pelo simulador ao montar o BR Code de teste
MOCK_PIX_KEY="pagamentos@ticketeira.com.br"

# ---- Regras de negócio ----
# Taxa de serviço padrão em basis points (1000 = 10%)
DEFAULT_SERVICE_FEE_BPS="1000"
# Minutos até o pedido pendente expirar e devolver o estoque
ORDER_EXPIRATION_MINUTES="30"

# ---- Fuso horário ----
TZ="America/Sao_Paulo"
